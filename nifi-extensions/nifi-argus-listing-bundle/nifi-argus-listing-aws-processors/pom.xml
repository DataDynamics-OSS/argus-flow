<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.datadynamics.nifi</groupId>
        <artifactId>nifi-argus-listing-bundle</artifactId>
        <version>2.10.0-1</version>
    </parent>

    <artifactId>nifi-argus-listing-aws-processors</artifactId>
    <name>Argus Flow :: Listing :: listing-aws-processors</name>
    <description>ListS3</description>

    <dependencies>
        <dependency>
            <groupId>io.datadynamics.nifi</groupId>
            <artifactId>nifi-argus-listing-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-utils</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-listed-entity</artifactId>
        </dependency>
        <!-- AbstractS3Processor — META-INF/services 가 없어 그대로 의존한다 -->
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-aws-abstract-processors</artifactId>
            <version>${nifi.version}</version>
            <exclusions>
                <!-- AWS SDK 는 부모 NAR(nifi-aws-service-api-nar)이 제공한다 -->
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.encryption.s3</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-migration-utils</artifactId>
            <version>${nifi.version}</version>
        </dependency>
        <!-- 자격증명 서비스 API 와 AWS SDK 는 부모 NAR(nifi-aws-service-api-nar)이 제공한다 -->
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-aws-service-api</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>${software.amazon.awssdk.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-distributed-cache-client-service-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-record-serialization-service-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-record</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-ssl-context-service-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-proxy-configuration-api</artifactId>
        </dependency>

        <!-- AbstractAwsProcessor 의 클라이언트 캐시. 실행 시에는 nifi-standard-shared-nar 가 제공한다 -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-mock</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-mock-record-utils</artifactId>
        </dependency>
    </dependencies>
</project>
