<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- NiFi 2.x: extension bundles inherit from nifi-extension-bundles (was nifi-nar-bundles in 1.x) -->
    <parent>
        <groupId>org.apache.nifi</groupId>
        <artifactId>nifi-extension-bundles</artifactId>
        <version>2.10.0</version>
        <relativePath/>
    </parent>

    <groupId>io.datadynamics.nifi</groupId>
    <artifactId>nifi-argus-extensions</artifactId>
    <version>2.10.0-1</version>
    <packaging>pom</packaging>

    <name>Argus Flow :: NiFi Extensions</name>

    <properties>
        <nifi.version>2.10.0</nifi.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!-- upstream 방식의 도메인별 번들: NAR 단위로 의존성을 격리한다 -->
    <modules>
        <module>nifi-argus-standard-bundle</module>
        <module>nifi-argus-db-bundle</module>
        <module>nifi-argus-kudu-bundle</module>
        <module>nifi-argus-parquet-bundle</module>
        <module>nifi-argus-record-serialization-bundle</module>
        <module>nifi-argus-hive-bundle</module>
        <module>nifi-argus-reporting-bundle</module>
        <module>nifi-argus-iceberg-bundle</module>
        <module>nifi-argus-debezium-bundle</module>
        <module>nifi-argus-deltalake-bundle</module>
        <module>nifi-argus-flow-analysis-bundle</module>
        <module>nifi-argus-db-iaa-bundle</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.apache.nifi</groupId>
                <artifactId>nifi-api</artifactId>
                <version>${nifi.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.nifi</groupId>
                <artifactId>nifi-utils</artifactId>
                <version>${nifi.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.nifi</groupId>
                <artifactId>nifi-nar-maven-plugin</artifactId>
                <version>2.3.0</version>
                <extensions>true</extensions>
            </plugin>

            <!-- 라이선스 헤더 검사. 이 저장소의 상당수 소스가 Apache NiFi 파생이라
                 (CONTRIBUTING.md 의 라이선스 헤더 규약) 헤더 누락은 Apache-2.0 §4(c) 위반이 된다.
                 출처 불명 파일이 다시 유입되는 것을 빌드 단계에서 막는다. -->
            <plugin>
                <groupId>org.apache.rat</groupId>
                <artifactId>apache-rat-plugin</artifactId>
                <version>0.16.1</version>
                <configuration>
                    <consoleOutput>true</consoleOutput>
                    <excludes>
                        <exclude>**/target/**</exclude>
                        <exclude>**/*.md</exclude>
                        <!-- 고지 파일 자체와 ServiceLoader 등록 파일은 헤더를 넣을 수 없다 -->
                        <exclude>**/src/main/resources/META-INF/LICENSE</exclude>
                        <exclude>**/src/main/resources/META-INF/NOTICE</exclude>
                        <exclude>**/src/main/resources/META-INF/services/**</exclude>
                        <!-- 테스트 픽스처(Avro 스키마, 바이너리, 데이터 파일) -->
                        <exclude>**/src/test/resources/**</exclude>
                        <!-- NiFi 컴포넌트 문서 조각 -->
                        <exclude>**/additionalDetails.html</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>license-header-check</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
