<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.datadynamics.nifi</groupId>
        <artifactId>nifi-argus-db-iaa-bundle</artifactId>
        <version>2.10.0-1</version>
    </parent>

    <artifactId>nifi-argus-db-iaa-providers</artifactId>
    <packaging>jar</packaging>

    <name>Argus Flow :: DB IAA :: providers</name>
    <description>프로바이더 구현과 스키마 정본(src/main/resources/db)</description>

    <dependencies>
        <!-- LoginIdentityProvider / UserGroupProvider SPI. NiFi 가 제공하므로 provided. -->
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-framework-api</artifactId>
            <version>${nifi.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- single-user 프로바이더와 동일한 bcrypt 구현. 해시 형식($2b$12$)이 같아야
             기존 자격증명을 그대로 이관할 수 있다. -->
        <dependency>
            <groupId>at.favre.lib</groupId>
            <artifactId>bcrypt</artifactId>
            <version>0.10.2</version>
        </dependency>

        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>5.1.0</version>
        </dependency>

        <!-- 기본 지원 드라이버(BSD). MariaDB 드라이버는 LGPL-2.1 이라 번들하지 않고
             Database Driver Location 으로 사용자가 지정한다. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.7</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.4.240</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
