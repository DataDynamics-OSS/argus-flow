<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.datadynamics.nifi</groupId>
        <artifactId>nifi-argus-extensions</artifactId>
        <version>0.5.1</version>
    </parent>

    <artifactId>nifi-argus-trino-bundle</artifactId>
    <packaging>pom</packaging>

    <name>Argus Flow :: Trino Bundle</name>
    <description>Trino 조회·변환·유지보수 번들 (신규 구현)</description>

    <properties>
        <trino.version>483</trino.version>
        <trino.image>trinodb/trino:483</trino.image>
    </properties>

    <modules>
        <module>nifi-argus-trino-services-api</module>
        <module>nifi-argus-trino-services-api-nar</module>
        <module>nifi-argus-trino-services</module>
        <module>nifi-argus-trino-services-nar</module>
        <module>nifi-argus-trino-processors</module>
        <module>nifi-argus-trino-nar</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- shade된 단일 jar(전이 compile 의존성 없음). services NAR에만 번들한다 -->
            <dependency>
                <groupId>io.trino</groupId>
                <artifactId>trino-jdbc</artifactId>
                <version>${trino.version}</version>
            </dependency>
            <!-- Controller Service API 는 부모 NAR(nifi-standard-services-api-nar)이 제공한다 -->
            <dependency>
                <groupId>org.apache.nifi</groupId>
                <artifactId>nifi-dbcp-service-api</artifactId>
                <version>${nifi.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.nifi</groupId>
                <artifactId>nifi-ssl-context-service-api</artifactId>
                <version>${nifi.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.nifi</groupId>
                <artifactId>nifi-oauth2-provider-api</artifactId>
                <version>${nifi.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.nifi</groupId>
                <artifactId>nifi-record-serialization-service-api</artifactId>
                <version>${nifi.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.nifi</groupId>
                <artifactId>nifi-record</artifactId>
                <version>${nifi.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.nifi</groupId>
                <artifactId>nifi-mock</artifactId>
                <version>${nifi.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.nifi</groupId>
                <artifactId>nifi-mock-record-utils</artifactId>
                <version>${nifi.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>2.4.240</version>
                <scope>test</scope>
            </dependency>
            <!-- testcontainers 버전은 NiFi 2.10.0 상위 pom 의 testcontainers-bom(2.0.5)이 관리한다 -->
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <trino.test.image>${trino.image}</trino.test.image>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
