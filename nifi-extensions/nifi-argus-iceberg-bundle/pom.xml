<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.datadynamics.nifi</groupId>
        <artifactId>nifi-argus-extensions</artifactId>
        <version>2.10.0-1</version>
    </parent>

    <artifactId>nifi-argus-iceberg-bundle</artifactId>
    <packaging>pom</packaging>

    <name>Argus Flow :: Iceberg Bundle</name>
    <!-- Apache NiFi rel/nifi-1.28.0 (8ecf23e) nifi-iceberg-bundle 포팅 -->

    <properties>
        <iceberg.version>1.6.1</iceberg.version>
        <hive.version>3.1.3</hive.version>
        <hadoop.version>3.4.1</hadoop.version>
    </properties>

    <modules>
        <module>nifi-argus-iceberg-services-api</module>
        <module>nifi-argus-iceberg-services-api-nar</module>
        <module>nifi-argus-iceberg-services</module>
        <module>nifi-argus-iceberg-services-nar</module>
        <module>nifi-argus-iceberg-common</module>
        <module>nifi-argus-iceberg-processors</module>
        <module>nifi-argus-iceberg-nar</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Hive 3.1.3 전이 의존성 CVE 핀 (업스트림 1.28 유지) -->
            <dependency>
                <groupId>org.glassfish</groupId>
                <artifactId>javax.el</artifactId>
                <version>3.0.1-b12</version>
            </dependency>
            <dependency>
                <groupId>commons-beanutils</groupId>
                <artifactId>commons-beanutils</artifactId>
                <version>1.9.4</version>
            </dependency>
            <dependency>
                <groupId>org.apache.derby</groupId>
                <artifactId>derby</artifactId>
                <version>10.14.2.0</version>
            </dependency>
            <dependency>
                <groupId>org.apache.ant</groupId>
                <artifactId>ant</artifactId>
                <version>1.10.14</version>
            </dependency>
            <dependency>
                <groupId>org.codehaus.jettison</groupId>
                <artifactId>jettison</artifactId>
                <version>1.5.4</version>
            </dependency>
            <dependency>
                <groupId>com.nimbusds</groupId>
                <artifactId>nimbus-jose-jwt</artifactId>
                <version>9.41.2</version>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>33.3.1-jre</version>
            </dependency>
            <dependency>
                <groupId>org.codehaus.groovy</groupId>
                <artifactId>groovy-all</artifactId>
                <version>2.4.21</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
