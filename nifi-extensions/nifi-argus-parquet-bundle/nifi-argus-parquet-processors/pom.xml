<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.datadynamics.nifi</groupId>
        <artifactId>nifi-argus-parquet-bundle</artifactId>
        <version>0.5.1</version>
    </parent>

    <artifactId>nifi-argus-parquet-processors</artifactId>

    <name>Argus Flow :: Parquet :: parquet-processors</name>
    <description>Parquet processors and record writers</description>

    <dependencies>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-utils</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-record</artifactId>
            <version>${nifi.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-record-serialization-service-api</artifactId>
            <version>${nifi.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-schema-registry-service-api</artifactId>
            <version>${nifi.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-kerberos-user-service-api</artifactId>
            <version>${nifi.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-avro-record-utils</artifactId>
            <version>${nifi.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-hadoop-record-utils</artifactId>
            <version>${nifi.version}</version>
        </dependency>
        <!-- upstream parquet 공용 코드 재사용: ParquetUtils/ParquetConfig/NifiParquetOutputFile/AvroParquetHDFSRecordWriter 등.
             이 jar를 그대로 NAR에 번들하면 jar 안의 META-INF/services 때문에 upstream 컴포넌트 7종
             (org.apache.nifi.processors.parquet.PutParquet, org.apache.nifi.parquet.ParquetReader 등)이
             argus NAR에도 함께 등록된다. 그래서 provided로 두어 NAR에서 빼고, 필요한 클래스만
             아래 maven-dependency-plugin(unpack)으로 이 모듈 jar에 넣는다(META-INF/services 제외).
             이 jar의 런타임 의존성(parquet-avro, nifi-avro-record-utils, nifi-hadoop-record-utils 등)은
             이 pom에 compile로 직접 선언되어 있어 NAR 번들 목록은 그대로 유지된다. -->
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-parquet-processors</artifactId>
            <version>${nifi.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <!-- hadoop/parquet 버전은 upstream rel/nifi-2.10.0 nifi-parquet-bundle pom 기준 -->
        <dependency>
            <groupId>org.apache.hadoop</groupId>
            <artifactId>hadoop-client</artifactId>
            <version>${hadoop.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-reload4j</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-log4j12</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>log4j</groupId>
                    <artifactId>log4j</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-databind</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>commons-logging</groupId>
                    <artifactId>commons-logging</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.eclipse.jetty.websocket</groupId>
                    <artifactId>websocket-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.parquet</groupId>
            <artifactId>parquet-avro</artifactId>
            <version>${parquet.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.xerial.snappy</groupId>
                    <artifactId>snappy-java</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-mock</artifactId>
            <version>${nifi.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- nifi-parquet-processors(provided)에서 argus 코드가 실제로 참조하는 클래스만 이 jar에 포함한다.
                 포함 범위는 jdeps로 확인한 참조 폐쇄(closure)다:
                   - org/apache/nifi/parquet/utils/** (ParquetUtils, ParquetConfig, ParquetAttribute)
                   - org/apache/nifi/parquet/stream/** (NifiParquetOutputFile, NifiOutputStream)
                   - org/apache/nifi/parquet/hadoop/AvroParquetHDFSRecordWriter (upstream PutParquet이 사용)
                   - org/apache/nifi/processors/parquet/PutParquet (사내 PutParquet의 부모 클래스)
                 META-INF/services는 포함하지 않으므로 upstream 클래스는 NiFi에 컴포넌트로 등록되지 않는다.
                 upstream 버전을 올릴 때는 jdeps로 참조 범위를 다시 확인해야 한다. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>unpack-upstream-parquet-classes</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.apache.nifi</groupId>
                                    <artifactId>nifi-parquet-processors</artifactId>
                                    <version>${nifi.version}</version>
                                    <type>jar</type>
                                    <overWrite>true</overWrite>
                                    <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                                    <includes>org/apache/nifi/parquet/utils/**,org/apache/nifi/parquet/stream/**,org/apache/nifi/parquet/hadoop/AvroParquetHDFSRecordWriter*.class,org/apache/nifi/processors/parquet/PutParquet*.class</includes>
                                    <excludes>META-INF/**</excludes>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
