<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.datadynamics.nifi</groupId>
        <artifactId>argus-flow</artifactId>
        <version>0.5.1</version>
    </parent>

    <artifactId>argus-flow-distribution</artifactId>
    <packaging>pom</packaging>

    <name>Argus Flow :: Distribution</name>
    <description>Repackages the official NiFi binary with Argus NARs and conf overlay (tar.gz); RPM via nfpm</description>

    <properties>
        <!-- 릴리스 산출물 이름. 제품 버전과 기반 NiFi 버전을 함께 드러낸다
             (예: argus-flow-0.5.0-nifi-2.10.0-bin.tar.gz). tar.gz 의 최상위 디렉터리도 이 이름이다 -->
        <argus.dist.name>argus-flow-${project.version}-nifi-${nifi.version}</argus.dist.name>
        <!-- 업스트림 바이너리 nifi-${nifi.version}-bin.zip 의 SHA-512.
             정본: https://archive.apache.org/dist/nifi/${nifi.version}/nifi-${nifi.version}-bin.zip.sha512
             nifi.version 을 올리면 이 값도 반드시 함께 바꾼다(불일치 시 다운로드 단계에서 빌드 실패) -->
        <nifi.binary.sha512>a56c93cad6794beceeaa2e398a2ee9721160acdd16e479050c57879a661024113360c5d5778bcc379c76e6485805869e24cdb534bcf8cb30c6956d09377169d7</nifi.binary.sha512>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.datadynamics.nifi</groupId>
            <artifactId>nifi-argus-standard-nar</artifactId>
            <version>${project.version}</version>
            <type>nar</type>
        </dependency>
        <dependency>
            <groupId>io.datadynamics.nifi</groupId>
            <artifactId>nifi-argus-db-nar</artifactId>
            <version>${project.version}</version>
            <type>nar</type>
        </dependency>
        <dependency>
            <groupId>io.datadynamics.nifi</groupId>
            <artifactId>nifi-argus-kudu-nar</artifactId>
            <version>${project.version}</version>
            <type>nar</type>
        </dependency>
        <dependency>
            <groupId>io.datadynamics.nifi</groupId>
            <artifactId>nifi-argus-parquet-nar</artifactId>
            <version>${project.version}</version>
            <type>nar</type>
        </dependency>
        <dependency>
            <groupId>io.datadynamics.nifi</groupId>
            <artifactId>nifi-argus-record-serialization-nar</artifactId>
            <version>${project.version}</version>
            <type>nar</type>
        </dependency>
        <dependency>
            <groupId>io.datadynamics.nifi</groupId>
            <artifactId>nifi-argus-hive-services-api-nar</artifactId>
            <version>${project.version}</version>
            <type>nar</type>
        </dependency>
        <dependency>
            <groupId>io.datadynamics.nifi</groupId>
            <artifactId>nifi-argus-hive-nar</artifactId>
            <version>${project.version}</version>
            <type>nar</type>
        </dependency>
        <dependency>
            <groupId>io.datadynamics.nifi</groupId>
            <artifactId>nifi-argus-reporting-nar</artifactId>
            <version>${project.version}</version>
            <type>nar</type>
        </dependency>
        <!-- Debezium 임베디드 CDC 소스 (커넥터별 독립 NAR) -->
        <dependency>
            <groupId>io.datadynamics.nifi</groupId>
            <artifactId>nifi-argus-debezium-mysql-nar</artifactId>
            <version>${project.version}</version>
            <type>nar</type>
        </dependency>
        <dependency>
            <groupId>io.datadynamics.nifi</groupId>
            <artifactId>nifi-argus-debezium-postgresql-nar</artifactId>
            <version>${project.version}</version>
            <type>nar</type>
        </dependency>
        <dependency>
            <groupId>io.datadynamics.nifi</groupId>
            <artifactId>nifi-argus-debezium-oracle-nar</artifactId>
            <version>${project.version}</version>
            <type>nar</type>
        </dependency>
        <dependency>
            <groupId>io.datadynamics.nifi</groupId>
            <artifactId>nifi-argus-debezium-sqlserver-nar</artifactId>
            <version>${project.version}</version>
            <type>nar</type>
        </dependency>
        <!-- Delta Kernel 기반 경로형 Delta Lake 싱크 -->
        <dependency>
            <groupId>io.datadynamics.nifi</groupId>
            <artifactId>nifi-argus-deltalake-nar</artifactId>
            <version>${project.version}</version>
            <type>nar</type>
        </dependency>
        <!-- Iceberg 싱크 (upstream 1.28.0 → 2.10.0 포팅). services-api ← services/nar 계층이며
             copy-dependencies가 excludeTransitive=true 이므로 3종을 모두 명시 선언해야 target/nars 에 수집된다 -->
        <dependency>
            <groupId>io.datadynamics.nifi</groupId>
            <artifactId>nifi-argus-iceberg-services-api-nar</artifactId>
            <version>${project.version}</version>
            <type>nar</type>
        </dependency>
        <dependency>
            <groupId>io.datadynamics.nifi</groupId>
            <artifactId>nifi-argus-iceberg-services-nar</artifactId>
            <version>${project.version}</version>
            <type>nar</type>
        </dependency>
        <dependency>
            <groupId>io.datadynamics.nifi</groupId>
            <artifactId>nifi-argus-iceberg-nar</artifactId>
            <version>${project.version}</version>
            <type>nar</type>
        </dependency>
        <!-- Trino 조회·변환·유지보수 (신규 구현). services-api ← services/nar 계층이라 3종 모두 명시 -->
        <dependency>
            <groupId>io.datadynamics.nifi</groupId>
            <artifactId>nifi-argus-trino-services-api-nar</artifactId>
            <version>${project.version}</version>
            <type>nar</type>
        </dependency>
        <dependency>
            <groupId>io.datadynamics.nifi</groupId>
            <artifactId>nifi-argus-trino-services-nar</artifactId>
            <version>${project.version}</version>
            <type>nar</type>
        </dependency>
        <dependency>
            <groupId>io.datadynamics.nifi</groupId>
            <artifactId>nifi-argus-trino-nar</artifactId>
            <version>${project.version}</version>
            <type>nar</type>
        </dependency>
        <!-- 운영 거버넌스용 Flow Analysis Rule (스레드 풀·동시성·리스팅 스케줄·데드엔드·Iceberg 머지) -->
        <dependency>
            <groupId>io.datadynamics.nifi</groupId>
            <artifactId>nifi-argus-flow-analysis-nar</artifactId>
            <version>${project.version}</version>
            <type>nar</type>
        </dependency>
        <!-- 공식 2.10.0 바이너리에 미포함(include-hadoop 프로파일 전용)이지만
             nifi-argus-parquet-nar의 부모 NAR이라 동봉 필수 -->
        <dependency>
            <groupId>org.apache.nifi</groupId>
            <artifactId>nifi-hadoop-libraries-nar</artifactId>
            <version>${nifi.version}</version>
            <type>nar</type>
        </dependency>
        <!-- DB 기반 인증·인가 프로바이더 -->
        <dependency>
            <groupId>io.datadynamics.nifi</groupId>
            <artifactId>nifi-argus-db-iaa-nar</artifactId>
            <version>${project.version}</version>
            <type>nar</type>
        </dependency>
        <!-- 업스트림 FlowFile 이 대상을 정하는 트리거형 List (File/SFTP/FTP, S3, HDFS) -->
        <dependency>
            <groupId>io.datadynamics.nifi</groupId>
            <artifactId>nifi-argus-listing-nar</artifactId>
            <version>${project.version}</version>
            <type>nar</type>
        </dependency>
        <dependency>
            <groupId>io.datadynamics.nifi</groupId>
            <artifactId>nifi-argus-listing-aws-nar</artifactId>
            <version>${project.version}</version>
            <type>nar</type>
        </dependency>
        <dependency>
            <groupId>io.datadynamics.nifi</groupId>
            <artifactId>nifi-argus-listing-hadoop-nar</artifactId>
            <version>${project.version}</version>
            <type>nar</type>
        </dependency>
        <!-- 사용자 관리 CLI. NAR 이 아니라 실행 jar 이므로 tools/argus-user/ 로 따로 복사한다 -->
        <dependency>
            <groupId>io.datadynamics.nifi</groupId>
            <artifactId>nifi-argus-db-iaa-cli</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 항상 실행: 배포 대상 NAR 전체를 target/nars 에 수집 (tar.gz·docker 이미지 공용) -->
            <!-- 설정 TUI 를 단일 실행 파일(zipapp)로 만들어 tools/argus-config 에 둔다.
                 스크립트는 python3 가 없거나 3.10 미만이면 경고만 남기고 성공으로 끝난다 —
                 파이썬 없이도 NAR·tar.gz 를 빌드할 수 있어야 하기 때문이다. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>build-config-pyz</id>
                        <phase>package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${project.basedir}/../scripts/build-config-pyz.sh</executable>
                            <arguments>
                                <argument>${project.build.directory}/tools/argus-config/argus-config.pyz</argument>
                                <argument>${project.version}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-argus-nars</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeTypes>nar</includeTypes>
                            <excludeTransitive>true</excludeTransitive>
                            <outputDirectory>${project.build.directory}/nars</outputDirectory>
                        </configuration>
                    </execution>
                    <!-- 스키마 DDL 정본은 providers jar 안에 있다. DBA 가 직접 적용하는
                         경우를 위해 배포본에도 꺼내 둔다(설계상 자동 적용은 기본 비활성). -->
                    <execution>
                        <id>unpack-db-iaa-sql</id>
                        <phase>package</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>io.datadynamics.nifi</groupId>
                                    <artifactId>nifi-argus-db-iaa-providers</artifactId>
                                    <version>${project.version}</version>
                                    <includes>db/**</includes>
                                    <outputDirectory>${project.build.directory}/sql/db-iaa</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-user-cli</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>io.datadynamics.nifi</groupId>
                                    <artifactId>nifi-argus-db-iaa-cli</artifactId>
                                    <version>${project.version}</version>
                                    <destFileName>argus-user-cli.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}/tools/argus-user</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Heavy: downloads the ~800MB upstream binary. Activate explicitly with -Pdist -->
        <profile>
            <id>dist</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.googlecode.maven-download-plugin</groupId>
                        <artifactId>download-maven-plugin</artifactId>
                        <version>1.9.0</version>
                        <executions>
                            <execution>
                                <id>download-nifi-binary</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>wget</goal>
                                </goals>
                                <configuration>
                                    <url>https://archive.apache.org/dist/nifi/${nifi.version}/nifi-${nifi.version}-bin.zip</url>
                                    <!-- 공식 SHA-512 로 검증. 캐시(~/.m2/repository/.cache)에 있는 파일도 다시 검증한다 -->
                                    <sha512>${nifi.binary.sha512}</sha512>
                                    <unpack>true</unpack>
                                    <outputDirectory>${project.build.directory}/upstream</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>assemble-tarball</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                                <configuration>
                                    <descriptors>
                                        <descriptor>src/main/assembly/dist.xml</descriptor>
                                    </descriptors>
                                    <finalName>${argus.dist.name}-bin</finalName>
                                    <appendAssemblyId>false</appendAssemblyId>
                                    <tarLongFileMode>posix</tarLongFileMode>
                                </configuration>
                            </execution>
                            <!-- 이미 운영 중인 NiFi ${nifi.version} 에 확장만 추가하는 사용자용:
                                 target/nars 의 NAR 전부를 평탄한 zip 으로 (nar_extensions/ 에 그대로 풀면 됨) -->
                            <execution>
                                <id>assemble-nars-zip</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                                <configuration>
                                    <descriptors>
                                        <descriptor>src/main/assembly/nars.xml</descriptor>
                                    </descriptors>
                                    <finalName>argus-flow-nars-${project.version}</finalName>
                                    <appendAssemblyId>false</appendAssemblyId>
                                </configuration>
                            </execution>
                            <!-- DB 인증·인가 스키마 DDL (DBA 가 직접 적용하는 환경용) -->
                            <execution>
                                <id>assemble-db-iaa-sql-zip</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                                <configuration>
                                    <descriptors>
                                        <descriptor>src/main/assembly/db-iaa-sql.xml</descriptor>
                                    </descriptors>
                                    <finalName>argus-flow-db-iaa-sql-${project.version}</finalName>
                                    <appendAssemblyId>false</appendAssemblyId>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
