<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 http://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>bin</id>
    <formats>
        <format>tar.gz</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>argus-flow-nifi-${project.version}</baseDirectory>

    <fileSets>
        <!-- upstream NiFi binary, unpacked by download-maven-plugin.
             bin/ 은 실행 권한 보존을 위해 별도 fileSet으로 분리 -->
        <fileSet>
            <directory>${project.build.directory}/upstream/nifi-${nifi.version}</directory>
            <outputDirectory>.</outputDirectory>
            <excludes>
                <exclude>bin/**</exclude>
                <!-- conf 오버레이로 교체하는 파일이 생기면 여기에 exclude 추가 (conf/README.md 참조) -->
                <exclude>conf/login-identity-providers.xml</exclude>
                <exclude>conf/authorizers.xml</exclude>
                <!-- 런타임 산출물 제외.
                     upstream fileSet 은 target/upstream/ 을 통째로 복사하므로, 그 디렉터리에서
                     NiFi 를 한 번이라도 기동하면 생성된 인증서·플로우·사용자 파일이 배포본에
                     따라 들어간다. 실제로 그런 일이 있었다(자체 서명 keystore 가 tar 에 포함됨).
                     빌드 캐시가 깨끗하다는 가정에 기대지 않고 여기서 막는다. -->
                <exclude>conf/*.p12</exclude>
                <exclude>conf/*.jks</exclude>
                <exclude>conf/flow.json.gz</exclude>
                <exclude>conf/flow.xml.gz</exclude>
                <exclude>conf/users.xml</exclude>
                <exclude>conf/authorizations.xml</exclude>
                <exclude>conf/archive/**</exclude>
                <exclude>logs/**</exclude>
                <exclude>work/**</exclude>
                <exclude>run/**</exclude>
                <exclude>state/**</exclude>
                <exclude>*_repository/**</exclude>
            </excludes>
        </fileSet>
        <fileSet>
            <directory>${project.build.directory}/upstream/nifi-${nifi.version}/bin</directory>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0755</fileMode>
        </fileSet>
        <!-- Argus NARs + nifi-hadoop-libraries-nar -->
        <fileSet>
            <directory>${project.build.directory}/nars</directory>
            <outputDirectory>extensions</outputDirectory>
        </fileSet>
        <!-- conf 오버레이 -->
        <fileSet>
            <directory>${project.basedir}/src/main/resources/conf</directory>
            <outputDirectory>conf</outputDirectory>
            <excludes>
                <exclude>README.md</exclude>
            </excludes>
        </fileSet>
        <!-- 운영 스크립트 -->
        <fileSet>
            <directory>${project.basedir}/src/main/resources/bin</directory>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0755</fileMode>
            <excludes>
                <exclude>README.md</exclude>
            </excludes>
        </fileSet>
        <!-- DB 인증·인가 스키마 DDL. 애플리케이션에 DDL 권한을 주지 않는 환경에서
             DBA 가 직접 적용한다 -->
        <fileSet>
            <directory>${project.build.directory}/sql/db-iaa/db</directory>
            <outputDirectory>sql/db-iaa</outputDirectory>
        </fileSet>
        <!-- 설정 TUI. bin/argus-config.sh 가 이 경로를 참조한다.
             python3 없이 빌드하면 이 디렉터리가 비어 있을 수 있다 -->
        <fileSet>
            <directory>${project.build.directory}/tools/argus-config</directory>
            <outputDirectory>tools/argus-config</outputDirectory>
            <fileMode>0755</fileMode>
        </fileSet>
        <!-- 사용자 관리 CLI. bin/argus-user.sh 가 이 경로를 참조한다 -->
        <fileSet>
            <directory>${project.build.directory}/tools/argus-user</directory>
            <outputDirectory>tools/argus-user</outputDirectory>
        </fileSet>
    </fileSets>

    <files>
        <!-- 인증서 생성 스크립트. 소스의 scripts/ssl/ 을 정본으로 두고 조립 시점에
             가져온다 — 복사본을 만들면 반드시 갈라진다.
             argus-config.sh 의 tls:generate 레시피가 이 경로를 안내한다. -->
        <file>
            <source>${project.basedir}/../scripts/ssl/ssl-generate-openssl.sh</source>
            <outputDirectory>bin</outputDirectory>
            <destName>argus-ssl.sh</destName>
            <fileMode>0755</fileMode>
        </file>
    </files>
</assembly>
