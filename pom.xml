<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.datadynamics.nifi</groupId>
    <artifactId>argus-flow</artifactId>
    <version>2.10.0-1</version>
    <packaging>pom</packaging>

    <name>Argus Flow</name>
    <description>Apache NiFi 2.10.0 packaging, custom extensions and K8s operator</description>
    <url>https://github.com/DataDynamics-OSS/argus-flow</url>

    <organization>
        <name>Data Dynamics Inc.</name>
        <url>https://www.data-dynamics.io/</url>
    </organization>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/DataDynamics-OSS/argus-flow</url>
        <connection>scm:git:https://github.com/DataDynamics-OSS/argus-flow.git</connection>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/DataDynamics-OSS/argus-flow/issues</url>
    </issueManagement>

    <properties>
        <nifi.version>2.10.0</nifi.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <modules>
        <module>nifi-extensions</module>
        <module>distribution</module>
    </modules>
</project>
